{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestortrafego",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Bindings — create resources in CF dashboard / wrangler before first remote use
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestortrafego",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FLAGS",
      "id": "REPLACE_WITH_KV_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "gestortrafego-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "gestortrafego-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  }
}
